{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "proxy-client",
  "version": "0.1.3",
  "identifier": "com.yduas.proxy-client",
  "build": {
    "frontendDist": "https://user.yduas.cc/",
    "devUrl": "http://localhost:1424",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "title": "代理客户端",
        "url": "https://user.yduas.cc/",
        "width": 1080,
        "height": 760,
        "minWidth": 860,
        "minHeight": 600,
        "resizable": true,
        "maximized": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/sing-box",
      "binaries/xray"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      },
      "nsis": {
        "installerHooks": "installer-hooks.nsh"
      }
    },
    "icon": [
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Utility",
    "shortDescription": "代理节点客户端",
    "longDescription": "登录查看管理员分配的代理节点"
  }
}